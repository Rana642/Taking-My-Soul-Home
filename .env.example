# NEXT_PUBLIC_SITE_URL: canonical production URL of the site.
# Used for metadata (canonical, Open Graph), JSON-LD, sitemap.xml and robots.txt.
# Falls back to https://takingmysoulhome.com if unset. Set to your Vercel
# preview/production URL per environment.
NEXT_PUBLIC_SITE_URL="https://takingmysoulhome.com"

# NEXT_PUBLIC_ALLOW_INDEXING: set to "true" ONLY at launch (real content +
# real domain). Left unset/false, every page is noindex and robots.txt blocks
# all crawlers — keeps preview/staging deploys out of Google.
NEXT_PUBLIC_ALLOW_INDEXING="false"
