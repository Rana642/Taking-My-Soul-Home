# NEXT_PUBLIC_SITE_URL: canonical production URL of the site.
# Used for metadata (canonical, Open Graph), JSON-LD, sitemap.xml and robots.txt.
# Falls back to https://takingmysoulhome.com if unset. Set to your Vercel
# preview/production URL per environment.
NEXT_PUBLIC_SITE_URL="https://takingmysoulhome.com"

# NEXT_PUBLIC_ALLOW_INDEXING: set to "true" ONLY at launch (real content +
# real domain). Left unset/false, every page is noindex and robots.txt blocks
# all crawlers — keeps preview/staging deploys out of Google.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# WORDPRESS_GRAPHQL_URL: headless WordPress (WPGraphQL) endpoint the frontend
# reads content from. Server-side. Set in Vercel. Temp Hostinger URL for now;
# point at https://cms.takingmysoulhome.com/graphql once that subdomain is live.
WORDPRESS_GRAPHQL_URL="https://cms.takingmysoulhome.com/graphql"

# NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL: same endpoint, exposed to the browser for
# the client-side search modal. Keep it identical to WORDPRESS_GRAPHQL_URL.
NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL="https://cms.takingmysoulhome.com/graphql"
